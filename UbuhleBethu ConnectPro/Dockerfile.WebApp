FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["Ubuhlebethu-Web/UbuhleBethu-WebApp/UbuhlebethuConnectPro.WebApp.csproj", "Ubuhlebethu-Web/UbuhleBethu-WebApp/"]
COPY ["Ubuhlebethu-Web/UbuhlebethuConnectPro.Core/UbuhlebethuConnectPro.Core.csproj", "Ubuhlebethu-Web/UbuhlebethuConnectPro.Core/"]
COPY ["Ubuhlebethu-Web/UbuhlebethuConnectPro.Infrastructure/UbuhlebethuConnectPro.Infrastructure.csproj", "Ubuhlebethu-Web/UbuhlebethuConnectPro.Infrastructure/"]
RUN dotnet restore "Ubuhlebethu-Web/UbuhleBethu-WebApp/UbuhlebethuConnectPro.WebApp.csproj"
COPY . .
WORKDIR "/src/Ubuhlebethu-Web/UbuhleBethu-WebApp"
RUN dotnet build "UbuhlebethuConnectPro.WebApp.csproj" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish "UbuhlebethuConnectPro.WebApp.csproj" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "UbuhlebethuConnectPro.WebApp.dll"]
