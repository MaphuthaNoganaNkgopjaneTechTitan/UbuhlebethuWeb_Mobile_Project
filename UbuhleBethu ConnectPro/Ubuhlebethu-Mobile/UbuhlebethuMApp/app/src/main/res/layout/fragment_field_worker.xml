<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Bar with Logo, Settings, and Logout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgHeaderLogoWorker"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ubuhlebethu_logo"
                android:contentDescription="Ubuhlebethu Logo" />

            <TextView
                android:id="@+id/tvHeaderTitleWorker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/imgHeaderLogoWorker"
                android:layout_toStartOf="@id/headerActionsWorker"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text="👷 Field Worker Portal"
                android:textColor="@color/ubuhlebethu_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeStepGranularity="1sp" />

            <LinearLayout
                android:id="@+id/headerActionsWorker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSettingsFieldWorker"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings_gear"
                    android:contentDescription="Settings"
                    app:tint="@color/colorTextPrimary" />

                <Button
                    android:id="@+id/btnLogoutFieldWorker"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="LOG OUT"
                    android:textSize="12sp"
                    android:textColor="@color/ubuhlebethu_red"
                    app:strokeColor="@color/ubuhlebethu_red" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Card: Worker Shift Time Log -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Shift &amp; Attendance Check-In"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Your Full Name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/colorInputBackground"
                    app:boxStrokeColor="@color/colorInputBorder"
                    app:boxStrokeErrorColor="@color/colorInputBorderError"
                    android:textColorHint="@color/colorInputHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkerNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorInputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvProjectLoadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Loading projects..."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spFieldProjectSelect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvShiftStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Status: Not Checked In"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStartShift"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorSuccess"
                        android:textColor="@android:color/white"
                        android:text="START JOB"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnFinishShift"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorError"
                        android:textColor="@android:color/white"
                        android:text="FINISH JOB"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Scan Materials & Active Tasks -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦 Scan Materials &amp; Active Tasks"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFieldScanMaterials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/colorButtonPrimaryBackground"
                    android:textColor="@color/colorButtonPrimaryText"
                    android:text="📷 Scan Site Materials / Barcode"
                    app:cornerRadius="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Assigned Work Tasks:"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActiveTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_assigned_task" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Log Work, Upload Photos, Tag GPS & Submit -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Log Work, Upload Photo &amp; Tag GPS"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Work Log Description"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/colorInputBackground"
                    app:boxStrokeColor="@color/colorInputBorder"
                    app:boxStrokeErrorColor="@color/colorInputBorderError"
                    android:textColorHint="@color/colorInputHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkLogDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textColor="@color/colorInputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnUploadPhoto"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/colorTextPrimary"
                        app:strokeColor="@color/colorOutline"
                        android:text="📷 Photo"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnTagGPS"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/colorTextPrimary"
                        app:strokeColor="@color/colorOutline"
                        android:text="📍 Tag GPS"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="GPS: Not Tagged"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary" />

                <Button
                    android:id="@+id/btnSubmitWorkLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/colorSuccess"
                    android:textColor="@android:color/white"
                    android:text="🚀 Submit Work Log"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Attendance Status Summary -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="My Submitted Attendance Record"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_attendance" />

        <!-- AI Assistant Chat Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorAiAssistantBackground"
            app:strokeColor="@color/colorAiAssistantBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:padding="16dp">

                <!-- Collapsible Header -->
                <LinearLayout
                    android:id="@+id/headerAiChatWorker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ ConnectPro AI Assistant"
                            android:textColor="@color/colorAiAssistantText"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvAiHeaderSubtitleWorker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap to expand / shrink assistant"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnAiToggleWorker"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Expand or shrink AI"
                        app:tint="@color/colorAiAssistantText" />
                </LinearLayout>

                <!-- Expandable / Collapsible Body -->
                <LinearLayout
                    android:id="@+id/layoutAiChatBodyWorker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Message history list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAiChatWorker"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/colorBackground"
                    android:padding="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="true" />

                <!-- Typing indicator -->
                <TextView
                    android:id="@+id/tvAiTypingWorker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="✦ Thinking…"
                    android:textSize="12sp"
                    android:textColor="@color/colorAiAssistantText"
                    android:visibility="gone" />

                <!-- Input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ask anything…"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/colorInputBackground"
                        app:boxStrokeColor="@color/colorInputBorder"
                        android:textColorHint="@color/colorInputHint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAiInputWorker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="3"
                            android:imeOptions="actionSend"
                            android:textColor="@color/colorInputText" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/btnAiSendWorker"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/colorAiAssistantText"
                        android:src="@android:drawable/ic_menu_send"
                        android:contentDescription="Send"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <!-- Quick prompts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiQuickTasksWorker"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📋 My Tasks"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:gravity="center"
                        app:cornerRadius="8dp"
                        android:textColor="@color/colorAiAssistantText"
                        app:strokeColor="@color/colorAiAssistantBorder" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiQuickProgressWorker"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📈 Progress"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:gravity="center"
                        app:cornerRadius="8dp"
                        android:textColor="@color/colorAiAssistantText"
                        app:strokeColor="@color/colorAiAssistantBorder" />
                </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>