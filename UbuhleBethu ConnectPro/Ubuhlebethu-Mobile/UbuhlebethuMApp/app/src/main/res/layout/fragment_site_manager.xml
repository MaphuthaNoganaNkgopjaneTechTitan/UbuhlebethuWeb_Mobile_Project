<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Bar with Logo, Settings, and Logout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgHeaderLogoManager"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ubuhlebethu_logo"
                android:contentDescription="Ubuhlebethu Logo" />

            <TextView
                android:id="@+id/tvHeaderTitleManager"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/imgHeaderLogoManager"
                android:layout_toStartOf="@id/headerActionsManager"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text="👷‍♂️ Site Manager"
                android:textColor="@color/ubuhlebethu_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeStepGranularity="1sp" />

            <LinearLayout
                android:id="@+id/headerActionsManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSettingsSiteManager"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings_gear"
                    android:contentDescription="Settings"
                    app:tint="@color/colorTextPrimary" />

                <Button
                    android:id="@+id/btnLogoutSiteManager"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="LOG OUT"
                    android:textSize="12sp"
                    android:textColor="@color/ubuhlebethu_red"
                    app:strokeColor="@color/ubuhlebethu_red" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Active Project Selection Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏢 Select Active Site / Project"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spProjectSelect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvProjectLoadStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Loading active projects..."
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Project Budget Overview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBudgetOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Project Budget Overview"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBudgetProjectTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Project Title"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Budget"
                                android:textSize="11sp"
                                android:textColor="@color/colorTextSecondary" />

                            <TextView
                                android:id="@+id/tvBudgetTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="R 0.00"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Spent (Approved)"
                                android:textSize="11sp"
                                android:textColor="@color/colorTextSecondary" />

                            <TextView
                                android:id="@+id/tvBudgetSpent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="R 0.00"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorWarning" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remaining"
                                android:textSize="11sp"
                                android:textColor="@color/colorTextSecondary" />

                            <TextView
                                android:id="@+id/tvBudgetRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="R 0.00"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorSuccess" />
                        </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBudgetVariance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Variance: 0.00%"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvBudgetWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/colorError"
                    android:gravity="center"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dynamic Risk / Alerts RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_alert_card" />

        <!-- Assign Tasks to Field Workers -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Assign Task to Field Worker"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Select Assigned Worker:"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />

                <Spinner
                    android:id="@+id/spWorkerSelect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Task Description / Work Assignment"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/colorInputBackground"
                    app:boxStrokeColor="@color/colorInputBorder"
                    app:boxStrokeErrorColor="@color/colorInputBorderError"
                    android:textColorHint="@color/colorInputHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAssignTaskTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/colorInputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnAssignTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/colorButtonPrimaryBackground"
                    android:textColor="@color/colorButtonPrimaryText"
                    android:text="➕ Assign Task to Worker"
                    app:cornerRadius="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Assigned Work Tasks Status:"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvManagerTrackTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_assigned_task" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Material Barcode Registration Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦 Material Barcode Registration"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Scan materials to register their barcode, name, and unit cost. Once registered, field workers scanning this item will automatically see its name and details."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRegisterMaterialBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="#FFFFFF"
                    android:text="📷 Scan &amp; Register Material"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit & Review Site Reports -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Submit Site Report"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Description"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/colorInputBackground"
                    app:boxStrokeColor="@color/colorInputBorder"
                    app:boxStrokeErrorColor="@color/colorInputBorderError"
                    android:textColorHint="@color/colorInputHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReportDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textColor="@color/colorInputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Progress % (0-100)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/colorInputBackground"
                    app:boxStrokeColor="@color/colorInputBorder"
                    app:boxStrokeErrorColor="@color/colorInputBorderError"
                    android:textColorHint="@color/colorInputHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReportProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/colorInputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnSubmitSiteReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/colorSuccess"
                    android:textColor="@android:color/white"
                    android:text="🔄 Submit Site Report"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnManagerUploadPhoto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/colorTextPrimary"
                    app:strokeColor="@color/colorOutline"
                    android:text="📌 Tag GPS &amp; Upload Progress Photo"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Assistant Chat Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorAiAssistantBackground"
            app:strokeColor="@color/colorAiAssistantBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:padding="16dp">

                <!-- Collapsible Header -->
                <LinearLayout
                    android:id="@+id/headerAiChatManager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ ConnectPro AI Assistant"
                            android:textColor="@color/colorAiAssistantText"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvAiHeaderSubtitleManager"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap to expand / shrink assistant"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnAiToggleManager"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Expand or shrink AI"
                        app:tint="@color/colorAiAssistantText" />
                </LinearLayout>

                <!-- Expandable / Collapsible Body -->
                <LinearLayout
                    android:id="@+id/layoutAiChatBodyManager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Message history list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAiChatManager"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/colorBackground"
                    android:padding="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="true" />

                <!-- Typing indicator -->
                <TextView
                    android:id="@+id/tvAiTypingManager"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="✦ Thinking…"
                    android:textSize="12sp"
                    android:textColor="@color/colorAiAssistantText"
                    android:visibility="gone" />

                <!-- Input row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ask anything…"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/colorInputBackground"
                        app:boxStrokeColor="@color/colorInputBorder"
                        android:textColorHint="@color/colorInputHint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAiInputManager"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="3"
                            android:imeOptions="actionSend"
                            android:textColor="@color/colorInputText" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <ImageButton
                        android:id="@+id/btnAiSendManager"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@color/colorAiAssistantText"
                        android:src="@android:drawable/ic_menu_send"
                        android:contentDescription="Send"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <!-- Quick prompts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiQuickBudget"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="💰 Budget"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:gravity="center"
                        app:cornerRadius="8dp"
                        android:textColor="@color/colorAiAssistantText"
                        app:strokeColor="@color/colorAiAssistantBorder" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiQuickExpenses"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📊 Expenses"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:gravity="center"
                        app:cornerRadius="8dp"
                        android:textColor="@color/colorAiAssistantText"
                        app:strokeColor="@color/colorAiAssistantBorder" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiQuickStatus"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📋 Status"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:gravity="center"
                        app:cornerRadius="8dp"
                        android:textColor="@color/colorAiAssistantText"
                        app:strokeColor="@color/colorAiAssistantBorder" />
                </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Worker Attendance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 Worker Attendance"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSelectAttendanceDate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 PICK DATE"
                android:textColor="@color/ubuhlebethu_red"
                app:strokeColor="@color/ubuhlebethu_red"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAttendanceSelectedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Date: Today"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvManagerAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_attendance" />

        <!-- Capture Site Cost / Expense Form -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCardBackground"
            app:strokeColor="@color/colorCardStroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Capture Site Cost / Expense"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Cost Item / Description"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/colorInputBackground"
                    app:boxStrokeColor="@color/colorInputBorder"
                    app:boxStrokeErrorColor="@color/colorInputBorderError"
                    android:textColorHint="@color/colorInputHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpenseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/colorInputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Amount (ZAR R)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/colorInputBackground"
                    app:boxStrokeColor="@color/colorInputBorder"
                    app:boxStrokeErrorColor="@color/colorInputBorderError"
                    android:textColorHint="@color/colorInputHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpenseAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/colorInputText" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnCaptureExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/colorInfo"
                    android:textColor="@android:color/white"
                    android:text="➕ Save Expense"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Manager Expenses -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="📊 Captured Site Costs &amp; Approvals"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_expense" />

    </LinearLayout>
</ScrollView>
