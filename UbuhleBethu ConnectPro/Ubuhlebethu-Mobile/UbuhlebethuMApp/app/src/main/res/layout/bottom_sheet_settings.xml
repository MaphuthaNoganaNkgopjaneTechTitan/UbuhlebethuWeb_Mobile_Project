<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/colorCardBackground">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/colorDividerStrong" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Application Settings"
        android:textColor="@color/colorTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Profile Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/colorBackground"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorCardStroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ubuhlebethu_logo"
                android:contentDescription="Profile Avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSettingsUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/tvSettingsRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Role: Staff"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Theme Setting -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎨 Display Theme Mode"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginBottom="6dp" />

    <RadioGroup
        android:id="@+id/rgThemeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbThemeLight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:text="Light"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbThemeDark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:text="Dark" />

        <RadioButton
            android:id="@+id/rbThemeSystem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:text="System" />
    </RadioGroup>

    <!-- Text Size & Accessibility Control -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👓 Text Size &amp; Readability (Vision Assistance)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scale app typography for low vision, visual fatigue, or compact viewing."
        android:textSize="12sp"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgTextSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbTextSizeSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:textSize="12sp"
            android:text="Small\n85%" />

        <RadioButton
            android:id="@+id/rbTextSizeDefault"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:textSize="12sp"
            android:text="Standard\n100%"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbTextSizeLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:textSize="12sp"
            android:text="Large\n115%" />

        <RadioButton
            android:id="@+id/rbTextSizeExtraLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/colorTextPrimary"
            android:textSize="12sp"
            android:text="X-Large\n130%" />
    </RadioGroup>

    <!-- Biometric Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchBiometrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔐 Biometric Quick Login (Fingerprint / Face)"
        android:textSize="14sp"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginBottom="12dp" />

    <!-- Notifications Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔔 Instant Push Notifications"
        android:textSize="14sp"
        android:textColor="@color/colorTextPrimary"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <!-- Actions -->
    <Button
        android:id="@+id/btnClearOfflineCache"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Clear Offline Local Cache"
        android:textColor="@color/colorError"
        app:strokeColor="@color/colorError"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="ConnectPro Mobile v1.0.0 • Ubuhlebethu"
        android:textSize="12sp"
        android:textColor="@color/colorTextTertiary"
        android:layout_marginBottom="12dp" />

</LinearLayout>
