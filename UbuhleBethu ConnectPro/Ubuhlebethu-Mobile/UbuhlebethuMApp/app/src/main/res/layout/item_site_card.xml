<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorCardBackground"
    app:strokeColor="@color/colorCardStroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Site Icon -->
        <ImageView
            android:id="@+id/ivSiteIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_alert_icon_circle"
            android:padding="6dp"
            android:src="@drawable/ubuhlebethu_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/ubuhlebethu_logo" />

        <!-- Site Title -->
        <TextView
            android:id="@+id/tvSiteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Site A: Soweto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            app:layout_constraintEnd_toStartOf="@+id/tvStatusBadge"
            app:layout_constraintStart_toEndOf="@id/ivSiteIcon"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Progress and Status Details -->
        <TextView
            android:id="@+id/tvProgressStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Progress: 68% | Status: Active"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSiteTitle"
            app:layout_constraintTop_toBottomOf="@id/tvSiteTitle" />

        <!-- Visual Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBarSite"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:progress="68"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvProgressStatus"
            app:layout_constraintTop_toBottomOf="@id/tvProgressStatus" />

        <!-- Active Status Badge on the top right -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_low"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Active"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>