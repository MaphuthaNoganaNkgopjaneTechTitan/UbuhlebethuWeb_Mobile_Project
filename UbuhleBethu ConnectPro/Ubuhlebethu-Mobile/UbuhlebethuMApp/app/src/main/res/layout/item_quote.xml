<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorCardBackground"
    app:strokeColor="@color/colorCardStroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvQuoteReference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending Quotation: UBU-0000"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/tvQuoteClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Client: —"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvQuoteBudget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Estimated Scope: R 0.00"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvQuoteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Status: Submitted"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnGenerateDraft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="AI ESTIMATE"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/colorInfo" />

            <Button
                android:id="@+id/btnApproveQuoteItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="✓ APPROVE"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/colorSuccess" />

            <Button
                android:id="@+id/btnRejectQuoteItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="✕ REJECT"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/colorError" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="*Reject operates locally"
            android:textSize="10sp"
            android:textColor="@color/colorTextTertiary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>