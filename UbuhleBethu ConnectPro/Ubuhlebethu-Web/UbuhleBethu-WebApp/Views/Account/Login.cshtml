@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Full-screen login — no sidebar
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Ubuhlebethu ConnectPro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <style>
            /* Modern Architectural Blueprint & Elevated Form Styling */
            .login-form-panel {
                background-color: #f8fafc;
                background-image: radial-gradient(at 100% 0%, rgba(155, 28, 28, 0.05) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(240, 122, 26, 0.05) 0px, transparent 40%), radial-gradient(#cbd5e1 1.2px, transparent 1.2px);
                background-size: 100% 100%, 100% 100%, 24px 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 24px;
                position: relative;
            }

            .login-card-container {
                width: 100%;
                max-width: 440px;
                background: #ffffff;
                border-radius: 16px;
                padding: 40px 36px;
                box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08), 0 0 1px 1px rgba(226, 232, 240, 0.9);
                border: 1px solid rgba(226, 232, 240, 0.8);
                position: relative;
                z-index: 2;
            }

            .login-form-title {
                font-size: 1.55rem;
                font-weight: 700;
                color: #0f172a;
                margin-bottom: 4px;
                letter-spacing: -0.02em;
            }

            .login-form-sub {
                font-size: 0.86rem;
                color: #64748b;
                margin-bottom: 26px;
            }

            .form-label {
                font-size: 0.8rem;
                font-weight: 600;
                color: #334155;
                margin-bottom: 6px;
                display: block;
            }

            .form-control {
                border: 1.5px solid #e2e8f0;
                border-radius: 8px;
                padding: 10px 14px;
                font-size: 0.88rem;
                color: #1e293b;
                background: #ffffff;
                transition: all 0.2s ease-in-out;
                width: 100%;
                box-sizing: border-box;
            }

                .form-control:focus {
                    border-color: #9b1c1c;
                    box-shadow: 0 0 0 3px rgba(155, 28, 28, 0.12);
                    outline: none;
                }

            .btn-signin {
                background: linear-gradient(135deg, #9b1c1c 0%, #7f1d1d 100%);
                border: none;
                color: #ffffff;
                border-radius: 8px;
                padding: 11px;
                font-size: 0.9rem;
                font-weight: 600;
                cursor: pointer;
                transition: transform 0.15s ease, box-shadow 0.15s ease;
                box-shadow: 0 4px 12px rgba(155, 28, 28, 0.25);
                width: 100%;
            }

                .btn-signin:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 16px rgba(155, 28, 28, 0.35);
                    background: linear-gradient(135deg, #a82020 0%, #881c1c 100%);
                }

                .btn-signin:active {
                    transform: translateY(0);
                }

            .security-badge {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                font-size: 0.72rem;
                color: #94a3b8;
                margin-top: 24px;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                font-weight: 600;
            }
    </style>
</head>
<body class="login-page">

    <div class="login-shell">

        <!-- ── Brand Panel ── -->
        <div class="login-brand">
            <div class="login-brand-logo">
                <div class="login-brand-mark" style="background: transparent;">
                    <img src="~/images/logo.png" alt="Ubuhlebethu Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                </div>
                <div class="login-brand-name">
                    Ubuhlebethu
                    <small>ConnectPro</small>
                </div>
            </div>

            <div class="login-tagline">
                Corporate<br />Construction<br /><em>Management</em>
            </div>
            <p class="login-desc">
                End-to-end project control for quantity surveying, client portals,
                executive reporting, and multi-site operations.
            </p>

            <!-- Feature list -->
            <div style="margin-top:36px; display:flex; flex-direction:column; gap:14px; position:relative;">
                <div style="display:flex; align-items:flex-start; gap:10px;">
                    <div style="width:20px; height:20px; background:rgba(155,28,28,0.3); border-radius:4px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:1px;">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f07a1a" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                    </div>
                    <span style="font-size:0.8rem; color:rgba(255,255,255,0.7); line-height:1.4;">Real-time multi-site project tracking</span>
                </div>
                <div style="display:flex; align-items:flex-start; gap:10px;">
                    <div style="width:20px; height:20px; background:rgba(155,28,28,0.3); border-radius:4px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:1px;">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f07a1a" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                    </div>
                    <span style="font-size:0.8rem; color:rgba(255,255,255,0.7); line-height:1.4;">BOQ costing, quotations and invoicing</span>
                </div>
                <div style="display:flex; align-items:flex-start; gap:10px;">
                    <div style="width:20px; height:20px; background:rgba(155,28,28,0.3); border-radius:4px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:1px;">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f07a1a" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                    </div>
                    <span style="font-size:0.8rem; color:rgba(255,255,255,0.7); line-height:1.4;">Role-based access: Client, Office, Executive</span>
                </div>
            </div>

            <div style="margin-top:auto; padding-top:40px; position:relative;">
                <div style="font-size:0.65rem; color:rgba(255,255,255,0.35); letter-spacing:0.04em;">
                    UBUHLEBETHU BUSINESS ENTERPRISE CC &nbsp;&bull;&nbsp; CONNECTPRO
                </div>
            </div>
        </div>

        <!-- ── Form Panel with Architectural Grid & Elevated Card ── -->
        <div class="login-form-panel">
            <div class="login-card-container">

                <div class="login-form-title">Welcome back</div>
                <div class="login-form-sub">Sign in to your ConnectPro workspace</div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error" style="background:#fee2e2; color:#dc2626; padding:10px 14px; border-radius:8px; font-size:0.82rem; margin-bottom:18px; border:1px solid #fecaca;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px; margin-right:6px;">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        Invalid username or password. Please try again.
                    </div>
                }

                <form method="post" asp-controller="Account" asp-action="Login" id="loginForm">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="form-group mb-3" style="margin-bottom: 16px;">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" class="form-control" id="username" name="username"
                               placeholder="Enter your username or email" autocomplete="username" autofocus required />
                    </div>

                    <div class="form-group" style="margin-bottom: 22px;">
                        <label for="password" class="form-label">Password</label>
                        <div style="position:relative;">
                            <input type="password" class="form-control" id="password" name="password"
                                   placeholder="Enter your password" autocomplete="current-password"
                                   style="padding-right:40px;" required />
                            <button type="button" onclick="togglePassword()"
                                    style="position:absolute; right:12px; top:50%; transform:translateY(-50%);
                                background:none; border:none; cursor:pointer; color:#94a3b8; padding:0; display:flex; align-items:center;">
                                <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-signin">
                        Sign In
                    </button>
                </form>

                <div style="margin-top:20px; text-align:center; font-size:0.84rem;">
                    <span style="color:#64748b;">New client? </span>
                    <a asp-controller="Account" asp-action="Register" style="color:#9b1c1c; font-weight:600; text-decoration:none;">Create a client account</a>
                </div>
                <div style="margin-top:8px; text-align:center; font-size:0.82rem;">
                    <a href="/" style="color:#94a3b8; text-decoration:none;">&larr; Back to Ubuhlebethu website</a>
                </div>

                <div class="security-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Secure 256-bit Encrypted Portal
                </div>

            </div>
        </div>
    </div>

    <script>
            function togglePassword() {
                var input = document.getElementById('password');
                var icon = document.getElementById('eyeIcon');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
                } else {
                    input.type = 'password';
                    icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
                }
            }
    </script>

</body>
</html>