@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var apiBaseUrl = Configuration["Api:BaseUrl"] ?? "http://localhost:5000";
    var projectId = ViewBag.ProjectId != null ? ViewBag.ProjectId.ToString() : "";
}

<!-- SignalR Client Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<style>
    /* Real-Time Live Notification Toast */
    .live-event-toast {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10500;
        min-width: 320px;
        max-width: 420px;
        background: #ffffff;
        color: #0f172a;
        border-radius: 12px;
        box-shadow: 0 16px 36px rgba(0,0,0,0.18), 0 2px 6px rgba(0,0,0,0.06);
        border-left: 5px solid #22c55e;
        overflow: hidden;
        animation: liveSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        display: flex;
        flex-direction: column;
    }

    .live-event-toast.offsite {
        border-left-color: #ef4444;
    }

    @@keyframes liveSlideIn {
        from { transform: translateY(-20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    @@keyframes liveFadeOut {
        from { transform: translateY(0); opacity: 1; }
        to { transform: translateY(-16px); opacity: 0; }
    }

    /* Live Card Fade-in */
    .new-live-report {
        animation: newReportHighlight 1.2s ease-out;
    }

    @@keyframes newReportHighlight {
        0% { background-color: #ecfdf5; transform: scale(0.98); }
        50% { background-color: #d1fae5; }
        100% { background-color: #ffffff; transform: scale(1); }
    }

    /* Smooth Progress Bar Transitions */
    .progress-fill, .progress-bar, [style*="width:"] {
        transition: width 0.75s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
</style>

<div id="live-toast-container"></div>

<script>
    (function initConnectProLiveUpdates() {
        if (typeof signalR === 'undefined') {
            console.warn('[ConnectPro Live] SignalR client script not loaded.');
            return;
        }

        const apiBase = '@apiBaseUrl'.replace(/\/+$/, '');
        const currentProjectId = '@projectId'.toLowerCase();
        const hubUrl = (apiBase ? apiBase : window.location.origin) + '/hubs/site-events';

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(hubUrl, {
                skipNegotiation: false,
                transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.ServerSentEvents | signalR.HttpTransportType.LongPolling
            })
            .withAutomaticReconnect([1000, 3000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.None)
            .build();

        // 1. Handle New Site Report & Photo Upload
        connection.on('SiteReportUploaded', function (data) {
            console.log('[ConnectPro Live] SiteReportUploaded:', data);

            // Trigger global DOM event for custom hooks
            window.dispatchEvent(new CustomEvent('connectpro:sitereport', { detail: data }));

            // Show Toast Notification
            showLiveToast(
                '📷 Live Site Update: ' + (data.constructionStage || 'General Progress'),
                (data.reportedBy ? data.reportedBy : 'Field worker') + ' uploaded a new report (' + data.progressPercent + '% complete)',
                data.photoUrl,
                data.isOffSite ? 'Off-Site (' + Math.round(data.distanceFromSiteMeters || 0) + 'm away)' : 'Verified On-Site'
            );

            // A) Update Progress Bar & Text on Current Page
            updatePageProgress(data.projectId, data.progressPercent);

            // B) If on Site Reports page, dynamically prepend the new card into the grid
            prependSiteReportCard(data);
        });

        // 2. Handle Progress Updates
        connection.on('ProjectProgressUpdated', function (data) {
            console.log('[ConnectPro Live] ProjectProgressUpdated:', data);
            updatePageProgress(data.projectId, data.progressPercent);
        });

        // 3. Handle Attendance Check-In / Out
        connection.on('AttendanceRecorded', function (data) {
            console.log('[ConnectPro Live] AttendanceRecorded:', data);
            window.dispatchEvent(new CustomEvent('connectpro:attendance', { detail: data }));

            const action = data.type === 'CheckIn' ? 'checked in on-site' : 'checked out';
            showLiveToast(
                '⏱️ Attendance Update',
                (data.workerName || 'Worker') + ' has ' + action + '.',
                null,
                data.isOffSite ? 'Off-Site Location' : 'On-Site Verified'
            );
        });

        // 4. Handle Materials Updates
        connection.on('MaterialUpdated', function (data) {
            console.log('[ConnectPro Live] MaterialUpdated:', data);
            showLiveToast('📦 Material Scanned', (data.materialName || 'Material') + ' registered on project.', null, 'Barcode: ' + data.barcode);
        });

        // Start connection
        async function start() {
            try {
                await connection.start();
                console.log('[ConnectPro Live] Connected to SiteEventsHub at:', hubUrl);
                if (currentProjectId) {
                    await connection.invoke('JoinProject', currentProjectId);
                }
            } catch (err) {
                console.warn('[ConnectPro Live] Reconnecting in 5s...', err.message);
                setTimeout(start, 5000);
            }
        }

        connection.onreconnected(function (connectionId) {
            console.log('[ConnectPro Live] Reconnected. Rejoining project:', currentProjectId);
            if (currentProjectId) {
                connection.invoke('JoinProject', currentProjectId).catch(console.error);
            }
        });

        start();

        // ─────────────────────────────────────────────────────────────────────
        // Helper: Update Progress Bars across Details, Client Portal & Lists
        // ─────────────────────────────────────────────────────────────────────
        function updatePageProgress(projectId, progress) {
            if (typeof progress !== 'number') return;
            const pct = Math.min(100, Math.max(0, Math.round(progress)));

            // 1. Manager Details page elements
            const progBar = document.getElementById('projectProgressBar') || document.querySelector('.project-progress-bar');
            const progText = document.getElementById('projectProgressText') || document.querySelector('.project-progress-text');

            if (progBar) {
                progBar.style.width = pct + '%';
            }
            if (progText) {
                progText.textContent = pct + '%';
            }

            // 2. Client Portal project card progress
            if (projectId) {
                const clientProgBar = document.getElementById('client-prog-bar-' + projectId) ||
                                      document.querySelector('[data-project-id="' + projectId + '"] .client-progress-fill');
                const clientProgText = document.getElementById('client-prog-text-' + projectId) ||
                                       document.querySelector('[data-project-id="' + projectId + '"] .client-progress-text');
                if (clientProgBar) clientProgBar.style.width = pct + '%';
                if (clientProgText) clientProgText.textContent = pct + '%';

                // Progressive milestone unlock check (Stage 2 at 40%, Stage 3 at 90%)
                const stage2Badge = document.getElementById('stage2-status-' + projectId);
                if (stage2Badge && pct >= 40 && stage2Badge.textContent.includes('Locked')) {
                    stage2Badge.className = 'badge bg-primary text-white';
                    stage2Badge.textContent = 'Ready to Pay';
                }
                const stage3Badge = document.getElementById('stage3-status-' + projectId);
                if (stage3Badge && pct >= 90 && stage3Badge.textContent.includes('Locked')) {
                    stage3Badge.className = 'badge bg-primary text-white';
                    stage3Badge.textContent = 'Ready to Pay';
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────────
        // Helper: Prepend Site Report to SiteReports Grid
        // ─────────────────────────────────────────────────────────────────────
        function prependSiteReportCard(data) {
            const grid = document.querySelector('.site-report-grid');
            if (!grid) return;

            // Remove empty placeholder card if present
            const emptyCard = document.querySelector('.site-report-grid-empty') || grid.closest('.card');
            if (emptyCard && emptyCard.textContent.includes('No Site Reports Recorded Yet')) {
                emptyCard.remove();
            }

            const card = document.createElement('article');
            card.className = 'card site-report-card shadow-sm border new-live-report mb-3';

            const liveSafePhotoUrl = `/SiteReports/Photo/${data.reportId}`;
            const photoHtml = data.photoUrl ? `
                <div class="photo-container" style="position:relative; cursor:pointer;"
                     onclick="if (typeof openPhotoLightbox === 'function') openPhotoLightbox('${liveSafePhotoUrl}', '${data.constructionStage || 'General Progress'}', '${data.reportedBy || 'Staff'}', 'Just now', '${data.progressPercent}%')">
                    <img src="${liveSafePhotoUrl}" alt="Site photo for ${data.constructionStage || 'General'}" class="site-report-photo" loading="lazy" />
                    <span class="photo-overlay-badge"><i class="bi bi-arrows-fullscreen me-1"></i>View Photo</span>
                </div>` : '';

            const badgeHtml = data.isOffSite
                ? `<span class="badge bg-danger text-white"><i class="bi bi-geo-alt-fill me-1"></i>Off-Site (${Math.round(data.distanceFromSiteMeters || 0)}m away)</span>`
                : `<span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>Verified On-Site</span>`;

            card.innerHTML = `
                ${photoHtml}
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h2 class="h5 mb-1 fw-bold">${data.constructionStage || 'General Progress'}</h2>
                        <span class="badge bg-success text-white">LIVE</span>
                    </div>
                    <p class="text-muted small mb-2 d-flex flex-wrap align-items-center gap-2">
                        <span>Just now · ${data.reportedBy || 'Staff'}</span>
                        ${badgeHtml}
                    </p>
                    <p class="mb-3 text-secondary">${data.description || 'Site progress logged.'}</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small fw-semibold text-muted">Progress Recorded</span>
                        <span class="badge bg-primary">${data.progressPercent}%</span>
                    </div>
                </div>
            `;

            grid.insertBefore(card, grid.firstChild);
        }

        // ─────────────────────────────────────────────────────────────────────
        // Helper: Sleek Floating Live Toast
        // ─────────────────────────────────────────────────────────────────────
        function showLiveToast(title, body, photoUrl, badgeText) {
            const container = document.getElementById('live-toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'live-event-toast p-3';

            let imgTag = '';
            if (photoUrl) {
                imgTag = `<img src="${photoUrl}" style="width:48px;height:48px;border-radius:8px;object-fit:cover;border:1px solid #e2e8f0;margin-right:12px;flex-shrink:0;" onerror="this.style.display='none'" />`;
            }

            toast.innerHTML = `
                <div style="display:flex; align-items:flex-start;">
                    ${imgTag}
                    <div style="flex:1;">
                        <div style="font-weight:700; font-size:0.9rem; color:#0f172a; margin-bottom:2px;">${title}</div>
                        <div style="font-size:0.8rem; color:#475569; line-height:1.3;">${body}</div>
                        ${badgeText ? `<div style="font-size:0.7rem; font-weight:600; color:#16a34a; margin-top:4px;">● ${badgeText}</div>` : ''}
                    </div>
                    <button type="button" style="background:none; border:none; font-size:1.1rem; line-height:1; color:#94a3b8; cursor:pointer; padding:0 0 0 8px;" onclick="this.closest('.live-event-toast').remove()">&times;</button>
                </div>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'liveFadeOut 0.3s forwards';
                setTimeout(() => toast.remove(), 300);
            }, 6000);
        }
    })();
</script>
