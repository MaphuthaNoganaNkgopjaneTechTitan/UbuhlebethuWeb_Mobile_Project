<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ubuhlebethu ConnectPro — Corporate Construction Management Platform" />
    <title>@ViewData["Title"] - ConnectPro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UbuhlebethuConnectPro.WebApp.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body>

    @{
        bool isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        string homeUrl = "/";
        string userName = User?.Identity?.Name ?? "";
        string userInitials = "";
        if (!string.IsNullOrEmpty(userName))
        {
            var parts = userName.Split(' ');
            userInitials = parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
                : userName.Substring(0, Math.Min(2, userName.Length)).ToUpper();
        }
        string userRole = "";
        if (isAuthenticated)
        {
            if (User!.IsInRole("Admin")) { userRole = "System Administrator"; homeUrl = "/Admin/Index"; }
            else if (User!.IsInRole("Office")) { userRole = "Office / QS"; homeUrl = "/Dashboard/Index"; }
            else if (User!.IsInRole("Executive")) { userRole = "Executive"; homeUrl = "/Dashboard/Executive"; }
            else if (User!.IsInRole("Manager") || User!.IsInRole("Management")) { userRole = "Management"; homeUrl = "/Dashboard/Management"; }
            else if (User!.IsInRole("Client")) { userRole = "Client"; homeUrl = "/Dashboard/ClientPortal"; }
            else { userRole = "User"; }
        }

        // Determine current controller for active-state
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        bool hideSidebar = (currentController == "Account" && (currentAction == "SetupMfa" || currentAction == "VerifyTwoFactor" || currentAction == "EnableMfa"));
    }

    <div class="app-shell">
        <!-- ── SIDEBAR ── -->
        @if (!hideSidebar)
        {
            <aside class="app-sidebar" id="appSidebar">

                <!-- Logo -->
                <a class="sidebar-logo" href="@homeUrl">
                    <div class="sidebar-logo-mark" style="background: transparent;">
                        <img src="~/images/logo.png" alt="Ubuhlebethu Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                    <div class="sidebar-logo-text">
                        Ubuhlebethu
                        <small>ConnectPro</small>
                    </div>
                </a>

                <!-- Navigation -->
                <nav class="sidebar-nav">

                    @if (isAuthenticated)
                    {
                        <div class="sidebar-section-label">Dashboards</div>

                        @if (User!.IsInRole("Office"))
                        {
                            <a class="sidebar-link @(currentController == "Dashboard" && (currentAction == "Index" || currentAction == "Office") ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="3" width="7" height="7" rx="1" />
                                    <rect x="14" y="3" width="7" height="7" rx="1" />
                                    <rect x="3" y="14" width="7" height="7" rx="1" />
                                    <rect x="14" y="14" width="7" height="7" rx="1" />
                                </svg>
                                Office &amp; QS Dashboard
                            </a>
                        }

                        @if (User!.IsInRole("Executive") || User!.IsInRole("Manager") || User!.IsInRole("Management"))
                        {
                            <a class="sidebar-link @(currentController == "Dashboard" && currentAction == "Executive" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Executive">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                                </svg>
                                Executive Overview
                            </a>
                        }

                        @if (User!.IsInRole("Manager") || User!.IsInRole("Management"))
                        {
                            <a class="sidebar-link @(currentController == "Dashboard" && currentAction == "Management" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Management">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <line x1="18" y1="20" x2="18" y2="10" />
                                    <line x1="12" y1="20" x2="12" y2="4" />
                                    <line x1="6" y1="20" x2="6" y2="14" />
                                </svg>
                                Management &amp; Finance
                            </a>
                             <a class="sidebar-link @(currentController == "ProjectManagement" ? "active" : "")"
                                asp-controller="ProjectManagement" asp-action="Index">
                                 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                     <path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
                                 </svg>
                                 Project Management
                             </a>
                        }

                        @* Manager review quotes workflow link (Restricted strictly to Manager, Management, Executive) *@
                        @if (User!.IsInRole("Manager") || User!.IsInRole("Management") || User!.IsInRole("Executive"))
                        {
                            <a class="sidebar-link @(currentController == "Manager" && currentAction == "ReviewQuotes" ? "active" : "")"
                               asp-controller="Manager" asp-action="ReviewQuotes">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                                Review Quotes
                            </a>
                        }

                        @if (User!.IsInRole("Client"))
                        {
                            <a class="sidebar-link @(currentController == "Dashboard" && currentAction == "ClientPortal" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="ClientPortal">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" />
                                    <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" />
                                </svg>
                                Client Portal
                            </a>
                        }

                        @if (User!.IsInRole("Client") || User!.IsInRole("Office"))
                        {
                            <div class="sidebar-section-label">Operations</div>
                        }

                        @if (User!.IsInRole("Client"))
                        {
                            <a class="sidebar-link @(currentController == "Quotation" && currentAction == "Create" ? "active" : "")"
                               asp-controller="Quotation" asp-action="Create">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <line x1="12" y1="18" x2="12" y2="12" />
                                    <line x1="9" y1="15" x2="15" y2="15" />
                                </svg>
                                New Quotation
                            </a>
                        }

                        @if (User!.IsInRole("Office"))
                        {
                            <a class="sidebar-link @(currentController == "Dashboard" && currentAction == "PendingQuotes" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="PendingQuotes">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg>
                                Pending Quotes
                            </a>
                        }

                        @if (User!.IsInRole("Manager") || User!.IsInRole("Management"))
                        {
                            <div class="sidebar-section-label">Analytics &amp; Reporting</div>
                            <a class="sidebar-link @(currentAction == "LiveStats" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="LiveStats">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                                </svg>
                                Live Statistics
                            </a>
                            <a class="sidebar-link @(currentAction == "PortfolioView" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="PortfolioView">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="3" y1="9" x2="21" y2="9"></line>
                                    <line x1="9" y1="21" x2="9" y2="9"></line>
                                </svg>
                                Portfolio View
                            </a>
                            <a class="sidebar-link @(currentAction == "Reports" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Reports">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                                Custom Reports
                            </a>
                            <a class="sidebar-link @(currentAction == "RegionalMap" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="RegionalMap">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                                    <line x1="8" y1="2" x2="8" y2="18"></line>
                                    <line x1="16" y1="6" x2="16" y2="22"></line>
                                </svg>
                                Regional Map
                            </a>
                            <a class="sidebar-link @(currentAction == "Export" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Export">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Data Export
                            </a>
                            <a class="sidebar-link @(currentAction == "AIReport" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="AIReport">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M12 2v20"></path>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                                AI Insights
                            </a>
                        }

                        @if (User!.IsInRole("Admin"))
                        {
                            <div class="sidebar-section-label">Administration</div>
                            <a class="sidebar-link @(currentController == "Admin" ? "active" : "")"
                               asp-controller="Admin" asp-action="Index">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                                    <circle cx="9" cy="7" r="4" />
                                    <path d="M23 21v-2a4 4 0 00-3-3.87" />
                                    <path d="M16 3.13a4 4 0 010 7.75" />
                                </svg>
                                User Management
                            </a>
                            <a class="sidebar-link @(currentController == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Health" ? "active" : "")"
                               asp-controller="Admin" asp-action="Health">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                                </svg>
                                System Health
                            </a>
                        }
                    }
                    else
                    {
                        <a class="sidebar-link" asp-controller="Account" asp-action="Login">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" />
                                <polyline points="10 17 15 12 10 7" />
                                <line x1="15" y1="12" x2="3" y2="12" />
                            </svg>
                            Sign In
                        </a>
                    }
                    @if (isAuthenticated)
                    {
                        <div class="sidebar-section-label">Tools</div>
                        <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Support" ? "active" : "")"
                           asp-controller="Support" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                            </svg>
                            Support Tickets
                        </a>
                    }
                </nav>

                <!-- User footer -->
                @if (isAuthenticated)
                {
                    <div class="sidebar-footer">
                        <div class="sidebar-user" id="sidebarUserMenu" onclick="toggleDropdownMenu(event, 'sidebarDropdown')">
                            <div class="sidebar-avatar">@userInitials</div>
                            <div class="sidebar-user-info">
                                <div class="sidebar-user-name">@userName</div>
                                <div class="sidebar-user-role">@userRole</div>
                            </div>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="rgba(168,188,208,0.6)" stroke-width="2">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </div>
                        <div class="dropdown-menu" id="sidebarDropdown" style="display: none; bottom:60px; top:auto;">
                            <div class="dropdown-header">@userName</div>
                            <div class="dropdown-item text-muted" style="cursor:default; font-size:0.7rem;">@userRole</div>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item w-100" style="border:none; background:none; text-align:left; width:100%; color:#dc2626; cursor:pointer;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                        <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                        <polyline points="16 17 21 12 16 7" />
                                        <line x1="21" y1="12" x2="9" y2="12" />
                                    </svg>
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </aside>
        }

        <!-- ── MAIN ── -->
        <div class="app-main">

            <!-- Top Header Bar -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="topbar-icon-btn d-none" id="sidebarToggle" onclick="toggleSidebar()" style="display:none !important;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <line x1="3" y1="12" x2="21" y2="12" />
                            <line x1="3" y1="18" x2="21" y2="18" />
                        </svg>
                    </button>

                    <div class="topbar-breadcrumb">
                        Ubuhlebethu ConnectPro &rsaquo; <span>@ViewData["Title"]</span>
                    </div>
                </div>

                <div class="topbar-right">
                    <div class="topbar-search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        <input type="text" placeholder="Search..." id="topbarSearch" />
                    </div>

                    @if (isAuthenticated)
                    {
                        @await Html.PartialAsync("_NotificationsBell")

                        <!-- Relative dropdown container -->
                        <div class="dropdown" style="position: relative;">
                            <div class="topbar-user-chip" id="topbarUserChipBtn" onclick="toggleDropdownMenu(event, 'topbarUserDrop')" style="cursor: pointer;">
                                <div class="topbar-avatar">@userInitials</div>
                                <span>@userName</span>
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="pointer-events: none;">
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                            </div>

                            <!-- Dropdown menu with explicit placement -->
                            <div class="dropdown-menu" id="topbarUserDrop" style="display: none; position: absolute; right: 0; top: calc(100% + 8px); min-width: 200px; background: #ffffff; border: 1px solid var(--color-border, #e2e8f0); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 9999; padding: 6px 0;">
                                <div class="dropdown-header" style="padding: 8px 16px; font-weight: 700; font-size: 0.85rem; color: var(--text-primary, #0f172a);">Signed in as @userName</div>
                                <div class="dropdown-item" style="padding: 2px 16px 8px; cursor: default; color: var(--text-muted, #64748b); font-size: 0.75rem;">@userRole</div>
                                <div class="dropdown-divider" style="height: 1px; background: var(--color-border, #e2e8f0); margin: 4px 0;"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item w-100" style="border: none; background: none; text-align: left; width: 100%; padding: 8px 16px; font-size: 0.85rem; color: #dc2626; display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width: 16px; height: 16px;">
                                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                            <polyline points="16 17 21 12 16 7" />
                                            <line x1="21" y1="12" x2="9" y2="12" />
                                        </svg>
                                        Sign Out
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Sign In</a>
                    }
                </div>
            </header>

            <!-- Page content -->
            <main class="app-content" role="main">
                @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="padding: 16px; background-color: #e6f4ea; color: #137333; border-radius: 4px; margin-bottom: 20px;">
                        @(TempData["Success"] ?? TempData["SuccessMessage"])
                    </div>
                }
                @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="padding: 16px; background-color: #fce8e6; color: #c5221f; border-radius: 4px; margin-bottom: 20px;">
                        @(TempData["Error"] ?? TempData["ErrorMessage"])
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Global Toast Container -->
    <div id="toastContainer" style="position: fixed; bottom: 24px; right: 24px; z-index: 9999; display: flex; flex-direction: column; gap: 12px;"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Toggle menu display
        function toggleDropdownMenu(event, menuId) {
        if (event) {
        event.stopPropagation();
        }
        const targetMenu = document.getElementById(menuId);
        if (!targetMenu) return;

        const isCurrentlyOpen = targetMenu.style.display === 'block';

        // Close all dropdown menus
        document.querySelectorAll('.dropdown-menu').forEach(menu => {
        menu.style.display = 'none';
        menu.classList.remove('show');
        });

        // Toggle selected menu
        if (!isCurrentlyOpen) {
        targetMenu.style.display = 'block';
        targetMenu.classList.add('show');
        }
        }

        // Close dropdowns on outside click
        document.addEventListener('click', function (e) {
        if (!e.target.closest('.dropdown') && !e.target.closest('.sidebar-user')) {
        document.querySelectorAll('.dropdown-menu').forEach(menu => {
        menu.style.display = 'none';
        menu.classList.remove('show');
        });
        }
        });

        // Mobile sidebar toggle
        function toggleSidebar() {
        document.getElementById('appSidebar').classList.toggle('open');
        }

        // Modern Toast Notification
        function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        const bgColor = type === 'success' ? '#16a34a' : (type === 'error' ? '#dc2626' : '#1d6fb8');

        toast.style.cssText = `
        background-color: ${bgColor};
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        font-size: 0.9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 12px;
        transform: translateX(120%);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        `;

        const icon = type === 'success'
        ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><polyline points="20 6 9 17 4 12"></polyline></svg>`
        : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;

        toast.innerHTML = `${icon} <span>${message}</span>`;
        container.appendChild(toast);

        setTimeout(() => { toast.style.transform = 'translateX(0)'; }, 10);

        setTimeout(() => {
        toast.style.transform = 'translateX(120%)';
        setTimeout(() => { toast.remove(); }, 300);
        }, 3000);
        }

        // TopBar Global Search Wire-up
        document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('topbarSearch');
        if (searchInput) {
        searchInput.addEventListener('input', function (e) {
        const query = e.target.value.toLowerCase().trim();
        const tableRows = document.querySelectorAll('table tbody tr');
        if (tableRows.length > 0) {
        tableRows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
        });
        } else {
        const cards = document.querySelectorAll('.job-card, .quote-card, .data-card');
        if (cards.length > 0) {
        cards.forEach(card => {
        const text = card.textContent.toLowerCase();
        card.style.display = text.includes(query) ? '' : 'none';
        });
        }
        }
        });
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_ChatbotPartial")
    @await Html.PartialAsync("_LiveUpdatesPartial")
</body>
</html>