@using UbuhlebethuConnectPro.WebApp.ApiClient
@using UbuhlebethuConnectPro.WebApp.Models.DTOs
@inject IConnectProApiClient ApiClient

@{
    var username = User?.Identity?.Name ?? string.Empty;
    var unreadCount = 0;
    List<NotificationDto> recent = new();
    try
    {
        if (!string.IsNullOrEmpty(username))
        {
            var notifications = await ApiClient.GetUnreadNotificationsAsync(username);
            if (notifications != null)
            {
                unreadCount = notifications.Count(n => !n.IsRead);
                recent = notifications.OrderByDescending(n => n.CreatedAt).Take(5).ToList();
            }
        }
    }
    catch { }
}

<div class="dropdown" style="position:relative; margin-right:8px;">
    <!-- Bell Icon Button configured with toggleDropdownMenu -->
    <div class="topbar-icon-btn"
         id="notifBellBtn"
         onclick="toggleDropdownMenu(event, 'notifDrop')"
         title="Notifications"
         style="position: relative; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--color-border, #e2e8f0); background: #ffffff; color: var(--text-primary, #1e293b); cursor: pointer;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width: 18px; height: 18px; pointer-events: none;">
            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 01-3.46 0" />
        </svg>
        @if (unreadCount > 0)
        {
            <span class="topbar-badge" style="position: absolute; top: -4px; right: -4px; width: 18px; height: 18px; border-radius: 50%; background: #dc2626; color: #ffffff; font-size: 0.68rem; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid #ffffff;">
                @(unreadCount > 9 ? "9+" : unreadCount.ToString())
            </span>
        }
    </div>

    <!-- Dropdown Menu with absolute positioning & high z-index -->
    <div class="dropdown-menu notif-dropdown" id="notifDrop"
         style="display: none; position: absolute; right: 0; top: calc(100% + 8px); min-width: 320px; background: #ffffff; border: 1px solid var(--color-border, #e2e8f0); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 9999; padding: 0; overflow: hidden;">

        <div class="dropdown-header" style="padding: 10px 16px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; font-weight: 700; font-size: 0.85rem; color: #0f172a; display: flex; justify-content: space-between; align-items: center;">
            <span>Notifications</span>
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger" style="font-size: 0.7rem; border-radius: 9999px;">@unreadCount new</span>
            }
        </div>

        <div style="max-height: 280px; overflow-y: auto;">
            @if (recent.Any())
            {
                @foreach (var n in recent)
                {
                    <div class="notif-item @(n.IsRead ? "" : "unread")"
                         onclick="handleNotificationClick(event, '@n.Id')"
                         style="padding: 10px 16px; border-bottom: 1px solid #f1f5f9; cursor: pointer; transition: background 0.15s ease;"
                         onmouseover="this.style.backgroundColor='#f8fafc'"
                         onmouseout="this.style.backgroundColor='transparent'">
                        <div class="notif-time" style="font-size: 0.72rem; color: #64748b; margin-bottom: 2px;">@n.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</div>
                        <div class="notif-msg" style="font-size: 0.82rem; color: #1e293b; line-height: 1.4;">@n.Message</div>
                    </div>
                }
            }
            else
            {
                <div class="notif-item" style="padding: 24px 16px; text-align: center; color: #64748b; font-size: 0.82rem;">
                    No unread notifications
                </div>
            }
        </div>

        <div class="dropdown-divider" style="margin: 0; height: 1px; background: #e2e8f0;"></div>
        <a class="dropdown-item" asp-controller="Notifications" asp-action="Index"
           style="display: block; text-align: center; padding: 10px; font-size: 0.78rem; font-weight: 600; color: var(--color-primary, #C5221F); text-decoration: none; background: #ffffff;">
            View all notifications &rsaquo;
        </a>
    </div>
</div>

<script>
    function handleNotificationClick(e, id) {
        e.stopPropagation();
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const formData = new FormData();
        formData.append('id', id);
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        fetch('/Notifications/MarkRead', {
            method: 'POST',
            body: formData
        })
        .finally(() => {
            window.location.href = '/Notifications/Index';
        });
    }
</script>