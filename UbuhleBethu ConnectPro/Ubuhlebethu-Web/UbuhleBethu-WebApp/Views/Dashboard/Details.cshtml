@section Scripts {
    <script>
        // 1. Tab Switching Function
        function activateTab(event, targetTabId) {
            if (event) {
                event.preventDefault();
            }

            // Toggle button states
            document.querySelectorAll('#myTab .tab-nav-link').forEach(btn => {
                btn.classList.remove('active');
            });
            if (event && event.currentTarget) {
                event.currentTarget.classList.add('active');
            }

            // Toggle pane visibility
            document.querySelectorAll('#myTabContent .tab-pane').forEach(pane => {
                pane.classList.remove('active');
                pane.style.display = 'none';
            });

            const activePane = document.getElementById(targetTabId);
            if (activePane) {
                activePane.classList.add('active');
                activePane.style.display = 'block';
            }
        }

        // 2. Modal Open / Close Controls
        function openAppModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.add('show');
            }
        }

        function closeAppModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('show');
            }
        }

        function closeAppModalOnOutside(e, modalId) {
            if (e.target.id === modalId) {
                closeAppModal(modalId);
            }
        }

        // 3. Saving: every button posts to the server and reloads on success, so what you see is what was saved.
        const detailsId = '@Model.Id';
        function csrf() { return document.querySelector('input[name="__RequestVerificationToken"]').value; }

        async function postForm(action, fields, btn) {
            const fd = new FormData();
            fd.append('__RequestVerificationToken', csrf());
            fd.append('id', detailsId);
            Object.keys(fields).forEach(k => { if (fields[k] !== undefined && fields[k] !== null) fd.append(k, fields[k]); });
            if (btn) btn.disabled = true;
            try {
                const r = await fetch('/Dashboard/' + action, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                let j = null;
                try { j = await r.json(); } catch (e) { }
                if (!r.ok || !j || !j.ok) throw new Error((j && j.error) || 'Could not save. Please try again.');
                return j;
            } finally { if (btn) btn.disabled = false; }
        }

        function finish(modalId, message, tab) {
            closeAppModal(modalId);
            showToast(message, 'success');
            location.hash = tab;
            setTimeout(() => location.reload(), 700);
        }
        function fail(e) { showToast(e.message || 'Could not save.', 'error'); }
        const val = id => document.getElementById(id).value;

        function saveJobModalChanges() {
            const btn = event.currentTarget;
            const progress = parseInt(val('mProgress'), 10);
            if (isNaN(progress) || progress < 0 || progress > 100) { showToast('Progress must be between 0 and 100.', 'error'); return; }
            postForm('SaveJob', { description: val('mDescription'), buildingType: val('mBuildingType'), estimatedCost: val('mEstimatedCost'),
                                  siteManager: val('mSiteManager'), nhbrcStatus: val('mNhbrcStatus'), status: val('mStatus'), progress: progress }, btn)
                .then(() => finish('editJobModal', 'Job details saved.', 'job-details')).catch(fail);
        }

        function saveClientModalChanges() {
            const btn = event.currentTarget;
            postForm('SaveClient', { clientName: val('mClientName'), phone: val('mClientPhone'), email: val('mClientEmail') }, btn)
                .then(() => finish('editClientModal', 'Client details saved.', 'job-details')).catch(fail);
        }

        function saveLocationModalChanges() {
            const btn = event.currentTarget;
            postForm('SaveLocation', { location: val('mLocation') }, btn)
                .then(() => finish('editLocationModal', 'Work location saved.', 'job-details')).catch(fail);
        }

        async function saveDocumentModalUpload() {
            const btn = event.currentTarget;
            const file = document.getElementById('mDocFile').files[0];
            if (!file) { showToast('Choose a file to upload.', 'error'); return; }
            if (file.size > 2 * 1024 * 1024) { showToast('The file is too large (limit 2 MB).', 'error'); return; }
            const fd = new FormData();
            fd.append('__RequestVerificationToken', csrf());
            fd.append('id', detailsId);
            fd.append('title', val('mDocName'));
            fd.append('category', val('mDocCategory'));
            fd.append('file', file);
            btn.disabled = true;
            try {
                const r = await fetch('@Url.Action("UploadDocument", "Dashboard")', { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
                let j = null; try { j = await r.json(); } catch (e) { }
                if (!r.ok || !j || !j.ok) throw new Error((j && j.error) || 'Could not upload. Please try again.');
                finish('uploadDocModal', 'Document uploaded.', 'documents');
            } catch (e) { fail(e); } finally { btn.disabled = false; }
        }

        function addActivity(kind, fields, modalId, message, tab, btn) {
            postForm('AddActivity', Object.assign({ kind: kind }, fields), btn)
                .then(() => finish(modalId, message, tab)).catch(fail);
        }

        function saveDailyLogModal() {
            if (!val('mDailyLogTitle').trim() || !val('mDailyLogText').trim()) { showToast('Enter a title and the site observation.', 'error'); return; }
            addActivity('DailyLog', { title: val('mDailyLogTitle'), body: val('mDailyLogText') }, 'addDailyLogModal', 'Daily log saved.', 'daily-logs', event.currentTarget);
        }

        function saveScheduleModal() {
            if (!val('mScheduleTitle').trim()) { showToast('Enter a milestone description.', 'error'); return; }
            addActivity('Milestone', { title: val('mScheduleTitle'), dueDate: val('mScheduleDate'), status: val('mScheduleStatus') }, 'addScheduleModal', 'Milestone saved.', 'schedule', event.currentTarget);
        }

        function savePOModal() {
            if (!val('mPOVendor').trim() || !val('mPODescription').trim()) { showToast('Enter the supplier and the items.', 'error'); return; }
            const amount = parseFloat(val('mPOAmount'));
            if (isNaN(amount) || amount <= 0) { showToast('Enter an order value greater than zero.', 'error'); return; }
            addActivity('PurchaseOrder', { title: val('mPOVendor'), body: val('mPODescription'), amount: amount }, 'addPOModal', 'Purchase order created.', 'purchase-orders', event.currentTarget);
        }

        function saveJobNoteInline() {
            const btn = event.currentTarget;
            postForm('SaveNotes', { notes: document.getElementById('noteArea').value }, btn).then(() => {
                const stat = document.getElementById('noteSavedStatus');
                stat.style.display = 'inline';
                setTimeout(() => { stat.style.display = 'none'; }, 2000);
                showToast('Notes saved.', 'success');
            }).catch(fail);
        }

        // Initialize Default Active Tab on DOM Ready
        document.addEventListener('DOMContentLoaded', function () {
            const tab = (location.hash || '#job-details').substring(1);
            const valid = ['job-details', 'daily-logs', 'schedule', 'purchase-orders', 'documents'];
            const target = valid.includes(tab) ? tab : 'job-details';
            document.querySelectorAll('#myTab .tab-nav-link').forEach(b => {
                b.classList.toggle('active', (b.getAttribute('onclick') || '').includes("'" + target + "'"));
            });
            activateTab(null, target);
        });
    </script>
}