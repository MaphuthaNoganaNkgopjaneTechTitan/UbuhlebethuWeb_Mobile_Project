@model UbuhlebethuConnectPro.WebApp.Controllers.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title h3 mb-1">Create User</h1>
        <p class="text-muted mb-0">Add a new user to the system and configure their access roles</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Users</a>
</div>

<div class="card shadow-sm border">
    <div class="card-body p-4">
        <form asp-action="CreateUser" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label fw-semibold">Username</label>
                    <input asp-for="UserName" class="form-control" placeholder="e.g. john_manager" required />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="e.g. john@ubuhlebethu.co.za" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 6 characters" required />
                    <div class="form-text">Must meet minimum password requirements.</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0">Assign Roles</label>
                    <span class="text-muted small">Select one or more roles for this user</span>
                </div>

                <div class="table-responsive border rounded">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">Assign</th>
                                <th style="width: 170px;">Role</th>
                                <th>Description / Access Level</th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (int i = 0; i < Model.Roles.Count; i++)
                        {
                            var roleName = Model.Roles[i].RoleName;
                            var description = roleName switch
                            {
                                "Admin" => "Full system administration, user management, audit logs, and configuration.",
                                "Manager" => "Project creation, budget approvals, contractor assignments, and milestone tracking.",
                                "Office" => "Office staff & Quantity Surveyor (QS) portal: quotes, invoices, attendance, site reports.",
                                "SiteManager" => "On-site mobile supervisor: material barcodes, attendance sign-off, work log verification.",
                                "FieldWorker" => "Mobile application field operative: daily work logs, GPS attendance check-in/out.",
                                "Client" => "Customer portal: view quotation, invoices, simulated payments, and milestone progress.",
                                _ => "Standard system access role."
                            };
                            var badgeClass = roleName switch
                            {
                                "Admin" => "bg-danger",
                                "Manager" => "bg-primary",
                                "Office" => "bg-info text-dark",
                                "SiteManager" => "bg-warning text-dark",
                                "FieldWorker" => "bg-success",
                                "Client" => "bg-secondary",
                                _ => "bg-dark"
                            };

                            <tr>
                                <td class="text-center">
                                    <input type="hidden" asp-for="Roles[i].RoleName" />
                                    <input type="checkbox" asp-for="Roles[i].Selected" class="form-check-input" style="cursor: pointer; width: 1.25rem; height: 1.25rem;" id="role_@i" />
                                </td>
                                <td>
                                    <label for="role_@i" class="mb-0 fw-bold" style="cursor: pointer;">
                                        <span class="badge @badgeClass me-2">@roleName</span>
                                    </label>
                                </td>
                                <td>
                                    <label for="role_@i" class="text-muted small mb-0" style="cursor: pointer;">
                                        @description
                                    </label>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4" style="background-color: var(--color-primary, #C5221F); border-color: var(--color-primary, #C5221F);">
                    <i class="bi bi-person-plus me-1"></i> Create User
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
