@model UbuhlebethuConnectPro.WebApp.Controllers.EditRolesViewModel
@{
    ViewData["Title"] = "Edit Roles";
}
    @if (Model.StaleRoles.Any())
    {
        <div class="alert alert-warning mb-3" role="alert">
            The following previous roles are no longer available and will not be submitted: @string.Join(", ", Model.StaleRoles)
        </div>
    }

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Roles for @Model.UserName</h1>
        <p class="page-subtitle">Manage user access and permissions</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" asp-controller="Admin" asp-action="ExportAuditLogs" asp-route-q="@Model.UserName">Export Log</a>
        <button class="btn btn-action-red" data-bs-toggle="modal" data-bs-target="#deactivateModal">Deactivate</button>
    </div>
</div>

<form method="post" asp-action="EditRoles">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-3" role="alert">
            <div asp-validation-summary="All"></div>
        </div>
    }
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="UserName" />
    <table class="table">
        <thead><tr><th>Role</th><th>Assigned</th></tr></thead>
        <tbody>
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <tr>
                <td>@Model.Roles[i].RoleName</td>
                <td>
                    <input type="hidden" asp-for="Roles[i].RoleName" />
                    <input type="checkbox" asp-for="Roles[i].Selected" class="form-check-input" />
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Roles.Any())
    {
        <div class="alert alert-warning" role="alert">There are currently no available roles to assign to this user.</div>
    }
    @if (Model.Roles.Any())
    {
        <button type="submit" class="btn btn-primary">Save</button>
    }
    else
    {
        <button type="button" class="btn btn-primary" disabled>No roles available</button>
    }
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@* Deactivate confirmation modal *@
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Deactivate">
                <div class="modal-header">
                    <h5 class="modal-title" id="deactivateModalLabel">Confirm Deactivate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <div class="mb-3">
                        <label for="reasonModal" class="form-label">Reason (optional, max 500 chars)</label>
                        <textarea id="reasonModal" name="reason" class="form-control" rows="3" maxlength="500" placeholder="Why are you deactivating this user?"></textarea>
                        <div class="form-text">This reason will be stored in the audit log.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Deactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>
