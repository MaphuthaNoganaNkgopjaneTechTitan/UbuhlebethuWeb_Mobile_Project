@model UbuhlebethuConnectPro.WebApp.Controllers.EditUserViewModel
@{
    ViewData["Title"] = $"Edit User — {Model.UserName}";
}

@if (Model.StaleRoles.Any())
{
    <div class="alert alert-warning mb-3" role="alert">
        The following previous roles are no longer available and will not be submitted: @string.Join(", ", Model.StaleRoles)
    </div>
}

<div class="page-header mb-4">
    <div>
        <h1 class="page-title">Edit User &amp; Roles: @Model.UserName</h1>
        <p class="page-subtitle">Update account credentials and system access permissions</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" asp-controller="Admin" asp-action="ExportAuditLogs" asp-route-q="@Model.UserName">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
            </svg>
            Export Log
        </a>
        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#deactivateModal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
            Deactivate
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Users
        </a>
    </div>
</div>

<form asp-action="EditUser" asp-route-id="@Model.Id" method="post" id="editUserForm">
    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-3" role="alert">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="row g-4">
        <!-- User Account Details -->
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0" style="font-size: 1.1rem; font-weight: 600;">Account Information</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-bold">Username</label>
                        <input asp-for="UserName" class="form-control" required />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assigned Roles Section -->
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0" style="font-size: 1.1rem; font-weight: 600;">Assigned Roles &amp; Permissions</h5>
                    <span class="badge bg-secondary">System Roles</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Select the access roles assigned to this user in the portal:</p>

                    @if (!Model.Roles.Any())
                    {
                        <div class="alert alert-warning mb-0" role="alert">
                            There are currently no available roles to assign to this user.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="font-weight: 600;">Role Name</th>
                                        <th style="font-weight: 600; text-align: center; width: 120px;">Assigned</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (int i = 0; i < Model.Roles.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" asp-for="Roles[i].RoleName" />
                                            <span class="fw-medium">@Model.Roles[i].RoleName</span>
                                        </td>
                                        <td style="text-align: center;">
                                            <input type="checkbox" asp-for="Roles[i].Selected" class="form-check-input" style="width: 1.25em; height: 1.25em; cursor: pointer;" />
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            Save Changes
        </button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@* Deactivate confirmation modal *@
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Deactivate">
                <div class="modal-header">
                    <h5 class="modal-title" id="deactivateModalLabel">Confirm Deactivate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="reasonModal" class="form-label">Reason (optional, max 500 chars)</label>
                        <textarea id="reasonModal" name="reason" class="form-control" rows="3" maxlength="500" placeholder="Why are you deactivating this user?"></textarea>
                        <div class="form-text">This reason will be stored in the audit log.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Deactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('editUserForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var roleCheckboxes = form.querySelectorAll('input[type="checkbox"][name*="Selected"]');
                    var anyChecked = Array.from(roleCheckboxes).some(function (cb) { return cb.checked; });
                    if (!anyChecked && roleCheckboxes.length > 0) {
                        e.preventDefault();
                        var existingAlert = document.getElementById('clientValidationAlert');
                        if (!existingAlert) {
                            var alertDiv = document.createElement('div');
                            alertDiv.id = 'clientValidationAlert';
                            alertDiv.className = 'alert alert-danger mb-3';
                            alertDiv.setAttribute('role', 'alert');
                            alertDiv.innerHTML = '<strong>Validation Error:</strong> At least one role must be assigned to the user.';
                            form.insertBefore(alertDiv, form.firstChild);
                        }
                        var roleSection = document.querySelector('.card-body .table-responsive') || document.querySelector('.card-body');
                        if (roleSection) {
                            roleSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                });
            }
        });
    </script>
}
