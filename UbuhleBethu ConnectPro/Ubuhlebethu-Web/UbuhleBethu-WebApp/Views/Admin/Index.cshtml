@model IEnumerable<UbuhlebethuConnectPro.WebApp.Controllers.AdminUserViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">User Management</h1>
        <p class="page-subtitle">Administer system access and roles</p>
    </div>
    <div class="page-actions">
        <a asp-action="CreateUser" class="btn btn-success" style="margin-right: 8px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;margin-right:6px;">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add User
        </a>
        <a asp-action="AuditLogs" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;margin-right:6px;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Audit Log
        </a>
    </div>
</div>
<div class="data-table-wrap">
    <div class="data-table-header">
        <p class="data-table-title">System Users</p>
        <div class="table-controls">
            <form method="get" class="d-flex align-items-center gap-2 m-0">
                <div class="table-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Search username or email..." />
                </div>
                <select name="role" class="form-select" style="width:auto; min-width:140px; padding: 6px 12px; font-size: 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background-color:#fff;">
                    <option value="">All Roles</option>
                    @foreach(var r in (List<string>)ViewBag.AvailableRoles)
                    {
                        if(ViewBag.Role == r)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
                <button class="btn btn-primary" type="submit">Filter</button>
                <button type="button" class="btn btn-secondary" onclick="exportTableToPdf('usersTable', 'System Users', 'system-users')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Download PDF
                </button>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table id="usersTable" class="table" style="width: 100%; text-align: left; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                    <th style="padding: 16px 20px; font-weight: 600;">User</th>
                    <th style="padding: 16px 20px; font-weight: 600;">Email</th>
                    <th style="padding: 16px 20px; font-weight: 600;">Roles</th>
                    <th style="padding: 16px 20px; font-weight: 600; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var u in Model)
            {
                <tr style="border-bottom: 1px solid var(--border-color); transition: background 0.2s ease;">
                    <td style="padding: 16px 20px; color: var(--text-main); font-weight: 500;">
                        <div style="display:flex; align-items:center; gap:12px;">
                                <div data-no-export style="width:32px; height:32px; border-radius:50%; background:var(--bg-accent); display:flex; align-items:center; justify-content:center; color:var(--text-main); font-size:0.75rem; font-weight:600;">
                                @(u.UserName.Substring(0, Math.Min(2, u.UserName.Length)).ToUpper())
                            </div>
                            @u.UserName
                        </div>
                    </td>
                    <td style="padding: 16px 20px; color: var(--text-secondary); font-size: 0.9rem;">@u.Email</td>
                    <td style="padding: 16px 20px;">
                        @foreach(var role in u.Roles)
                        {
                            <span class="badge badge-neutral" style="margin-right: 4px;">@role</span>
                        }
                    </td>
                    <td style="padding: 16px 20px; text-align: right; white-space: nowrap;">
                        <a asp-action="EditUser" asp-route-id="@u.Id" class="btn btn-primary btn-sm" style="margin-right: 6px;">Edit User</a>
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-secondary btn-sm" style="margin-right: 6px;">Details</a>
                        <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-outline-danger btn-sm" title="Permanently delete user">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="~/js/export-pdf.js"></script>
}