@model IEnumerable<UbuhlebethuConnectPro.WebApp.ApiClient.QuoteDto>

@{
    ViewData["Title"] = "Quotes Awaiting Management Review";
    var quotesList = Model?.ToList() ?? new List<UbuhlebethuConnectPro.WebApp.ApiClient.QuoteDto>();
    int pendingCount = quotesList.Count;
    decimal totalPipelineValue = quotesList.Sum(q => q.EstimatedBudget);
    decimal avgQuoteValue = pendingCount > 0 ? totalPipelineValue / pendingCount : 0m;
    decimal maxQuoteValue = quotesList.Any() ? quotesList.Max(q => q.EstimatedBudget) : 0m;
    var oldestQuote = quotesList.OrderBy(q => q.RequestDate).FirstOrDefault();
    var projectTypes = quotesList
        .Select(q => q.ProjectType)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .Distinct()
        .OrderBy(t => t)
        .ToList();
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Quotations Awaiting Management Review</h1>
        <p class="page-subtitle">Submitted by Office &amp; Quantity Surveyors for managerial verification, acceptance, or rejection</p>
    </div>
    <div class="page-actions">
        <a asp-action="Proposals" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            All Proposals
        </a>
        <button type="button" class="btn btn-secondary" onclick="exportTableToPdf('reviewQuotesTable', 'Quotations Awaiting Management Review', 'manager-quotes-awaiting-review')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download PDF
        </button>
    </div>
</div>

<!-- Management KPI Metric Cards -->
<div class="kpi-grid">
    <div class="kpi-card kpi-crimson">
        <div class="kpi-label">Pending Sign-Off</div>
        <div class="kpi-value">@pendingCount</div>
        <div class="kpi-sub">Quotes awaiting your decision</div>
    </div>
    <div class="kpi-card kpi-green">
        <div class="kpi-label">Total Pipeline Value</div>
        <div class="kpi-value" style="font-size: 1.4rem;">R @totalPipelineValue.ToString("N0")</div>
        <div class="kpi-sub">Combined estimates in queue</div>
    </div>
    <div class="kpi-card kpi-blue">
        <div class="kpi-label">Average Estimate</div>
        <div class="kpi-value" style="font-size: 1.4rem;">R @avgQuoteValue.ToString("N0")</div>
        <div class="kpi-sub">Across @pendingCount active submission@(pendingCount == 1 ? "" : "s")</div>
    </div>
    <div class="kpi-card kpi-orange">
        <div class="kpi-label">Largest Proposal</div>
        <div class="kpi-value" style="font-size: 1.4rem;">R @maxQuoteValue.ToString("N0")</div>
        <div class="kpi-sub">
            @(oldestQuote != null ? $"Oldest: {oldestQuote.RequestDate.ToLocalTime():dd MMM yyyy}" : "Queue is clear")
        </div>
    </div>
</div>

<!-- Main Table Card -->
<div class="data-table-wrap">
    <div class="data-table-header">
        <div>
            <p class="data-table-title">
                Review Queue
                <span id="quoteCountBadge" class="badge badge-neutral" style="font-size: 0.75rem; margin-left: 6px;">@pendingCount quote@(pendingCount == 1 ? "" : "s")</span>
            </p>
        </div>
        <div class="table-controls">
            <div class="table-search" style="min-width: 240px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="reviewQuotesSearch" placeholder="Search reference, client, location..." onkeyup="filterQuotesTable()" />
            </div>

            @if (projectTypes.Any())
            {
                <select id="projectTypeFilter" class="form-select" onchange="filterQuotesTable()" style="width: auto; min-width: 170px; padding: 6px 12px; font-size: 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border); background-color: #fff;">
                    <option value="">All Project Types</option>
                    @foreach (var pt in projectTypes)
                    {
                        <option value="@pt">@pt</option>
                    }
                </select>
            }
        </div>
    </div>

    @if (!quotesList.Any())
    {
        <div class="text-center py-5" style="padding: 60px 20px;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(34, 197, 94, 0.12); color: var(--color-success); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 28px; height: 28px;">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h4 style="font-size: 1.15rem; font-weight: 600; color: var(--text-primary); margin-bottom: 6px;">All Caught Up!</h4>
            <p class="text-muted" style="max-width: 440px; margin: 0 auto 20px; font-size: 0.88rem;">
                There are currently no quotations awaiting management review. When Office or QS teams submit an estimate, it will appear here for sign-off.
            </p>
            <a asp-action="Proposals" class="btn btn-secondary">
                Browse All Proposals
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table id="reviewQuotesTable" class="data-table" style="width: 100%;">
                <thead>
                    <tr>
                        <th style="white-space: nowrap; width: 130px;">Reference</th>
                        <th style="min-width: 200px;">Client</th>
                        <th style="min-width: 170px;">Project Type</th>
                        <th style="min-width: 200px;">Site Location</th>
                        <th style="text-align: right; white-space: nowrap; min-width: 150px;">Cost Estimate</th>
                        <th style="text-align: center; white-space: nowrap; width: 130px;">Status</th>
                        <th style="white-space: nowrap; width: 140px;">Date Submitted</th>
                        <th style="text-align: right; white-space: nowrap; width: 160px;" data-no-export="true">Action</th>
                    </tr>
                </thead>
                <tbody id="quoteTableBody">
                    @foreach (var quote in quotesList)
                    {
                        var clientName = string.IsNullOrWhiteSpace(quote.ClientName) ? "Unknown Client" : quote.ClientName;
                        var initials = string.Join("", clientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
                        if (string.IsNullOrEmpty(initials)) initials = "CL";

                        <tr class="quote-row"
                            data-ref="@quote.Reference.ToLowerInvariant()"
                            data-client="@clientName.ToLowerInvariant()"
                            data-type="@quote.ProjectType.ToLowerInvariant()"
                            data-location="@quote.SiteLocation.ToLowerInvariant()">
                            <td style="white-space: nowrap;">
                                <span class="td-mono" style="font-weight: 700; color: var(--color-primary); background: rgba(185, 28, 28, 0.08); border: 1px solid rgba(185, 28, 28, 0.2); padding: 4px 10px; border-radius: 4px; display: inline-block;">
                                    @quote.Reference
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width: 34px; height: 34px; border-radius: 50%; background: #ede9fe; color: #6d28d9; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem; flex-shrink: 0;">
                                        @initials
                                    </div>
                                    <div>
                                        <div class="td-primary">@clientName</div>
                                        @if (!string.IsNullOrWhiteSpace(quote.Company))
                                        {
                                            <div style="font-size: 0.72rem; color: var(--text-muted);">@quote.Company</div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(quote.Email))
                                        {
                                            <div style="font-size: 0.72rem; color: var(--text-muted);">@quote.Email</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-neutral" style="font-size: 0.78rem; font-weight: 500; padding: 5px 10px; display: inline-flex; align-items: center; gap: 6px;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 13px; height: 13px; color: var(--text-muted); flex-shrink: 0;">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                    </svg>
                                    @quote.ProjectType
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; align-items: flex-start; gap: 6px; color: var(--text-secondary); max-width: 240px;" title="@quote.SiteLocation">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px; color: #d97706; flex-shrink: 0; margin-top: 2px;">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    <span style="font-size: 0.8rem; line-height: 1.35; overflow: hidden; text-overflow: ellipsis;">
                                        @quote.SiteLocation
                                    </span>
                                </div>
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <span style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary); letter-spacing: -0.01em;">
                                    R @quote.EstimatedBudget.ToString("N2")
                                </span>
                                <span style="display: block; font-size: 0.7rem; color: var(--text-muted);">
                                    Total Estimate
                                </span>
                            </td>
                            <td style="text-align: center; white-space: nowrap;">
                                <span class="badge badge-warning" style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; font-weight: 600; font-size: 0.75rem;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #d97706; display: inline-block;"></span>
                                    @quote.Status
                                </span>
                            </td>
                            <td style="white-space: nowrap;">
                                <span style="font-weight: 500; font-size: 0.82rem; color: var(--text-primary);">
                                    @quote.RequestDate.ToLocalTime().ToString("dd MMM yyyy")
                                </span>
                                <span style="display: block; font-size: 0.72rem; color: var(--text-muted);">
                                    @quote.RequestDate.ToLocalTime().ToString("HH:mm")
                                </span>
                            </td>
                            <td style="text-align: right; white-space: nowrap;" data-no-export="true">
                                <a asp-controller="Quotation" asp-action="Details" asp-route-id="@quote.Id" class="btn btn-primary btn-sm" style="font-weight: 600; padding: 6px 14px; gap: 6px;">
                                    <span>Review &amp; Sign-Off</span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 13px; height: 13px;">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="noMatchingRows" class="text-center py-4" style="display: none; padding: 32px 16px;">
            <p class="text-muted mb-0" style="font-size: 0.9rem;">No quotations match your current search and filter criteria.</p>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="~/js/export-pdf.js"></script>

    <script>
        function filterQuotesTable() {
            var searchInput = document.getElementById('reviewQuotesSearch');
            var filterTerm = (searchInput ? searchInput.value : '').toLowerCase().trim();
            var typeSelect = document.getElementById('projectTypeFilter');
            var selectedType = (typeSelect ? typeSelect.value : '').toLowerCase().trim();

            var rows = document.querySelectorAll('.quote-row');
            var visibleCount = 0;

            rows.forEach(function(row) {
                var ref = row.getAttribute('data-ref') || '';
                var client = row.getAttribute('data-client') || '';
                var type = row.getAttribute('data-type') || '';
                var location = row.getAttribute('data-location') || '';

                var matchesSearch = !filterTerm ||
                    ref.indexOf(filterTerm) !== -1 ||
                    client.indexOf(filterTerm) !== -1 ||
                    location.indexOf(filterTerm) !== -1 ||
                    type.indexOf(filterTerm) !== -1;

                var matchesType = !selectedType || type === selectedType;

                if (matchesSearch && matchesType) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            var countBadge = document.getElementById('quoteCountBadge');
            if (countBadge) {
                countBadge.textContent = visibleCount + ' quote' + (visibleCount === 1 ? '' : 's');
            }

            var noMatchMsg = document.getElementById('noMatchingRows');
            if (noMatchMsg) {
                noMatchMsg.style.display = (visibleCount === 0 && rows.length > 0) ? 'block' : 'none';
            }
        }
    </script>
}