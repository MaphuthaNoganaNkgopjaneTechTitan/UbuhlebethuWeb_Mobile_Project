@model IReadOnlyList<UbuhlebethuConnectPro.WebApp.ApiClient.SiteReportDto>
@{
    ViewData["Title"] = "Site Reports & Photos";
    var projectId = ViewBag.ProjectId != null ? ViewBag.ProjectId.ToString() : "";
}

<div class="mb-3">
    @if (!string.IsNullOrEmpty(projectId))
    {
        <a href="@Url.Action("Details", "Dashboard", new { id = projectId })" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Project Details
        </a>
    }
    else
    {
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    }
</div>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title h3 mb-1">Site Reports &amp; Photos</h1>
        <p class="page-subtitle text-muted mb-0">Progress updates, verification badges, and on-site photos for this project</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card shadow-sm border">
        <div class="card-body text-center py-5">
            <div class="text-muted mb-2" style="font-size:2rem;">📷</div>
            <h5 class="fw-bold">No Site Reports Recorded Yet</h5>
            <p class="text-muted mb-0">Reports and photos submitted by site managers and mobile workers will appear here automatically.</p>
        </div>
    </div>
}
else
{
    <div class="site-report-grid">
        @foreach (var report in Model)
        {
            var photoUrl = Url.Action("Photo", "SiteReports", new { id = report.Id });
            var stageName = string.IsNullOrWhiteSpace(report.ConstructionStage) ? "General Progress" : report.ConstructionStage;
            var loggedTimeStr = report.LoggedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm");

            <article class="card site-report-card shadow-sm border">
                @if (!string.IsNullOrWhiteSpace(report.PhotoPath))
                {
                    <div class="photo-container" style="position:relative; cursor:pointer;" 
                         onclick="openPhotoLightbox('@photoUrl', '@stageName', '@report.ReportedBy', '@loggedTimeStr', '@report.ProgressPercent%')">
                        <img src="@photoUrl" alt="Site photo for @stageName" class="site-report-photo" loading="lazy"
                             onerror="this.onerror=null; this.src='data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22600%22%20height%3D%22400%22%20viewBox%3D%220%200%20600%20400%22%3E%3Crect%20fill%3D%22%231e293b%22%20width%3D%22600%22%20height%3D%22400%22%2F%3E%3Ccircle%20cx%3D%22300%22%20cy%3D%22170%22%20r%3D%2248%22%20fill%3D%22%23334155%22%2F%3E%3Ctext%20fill%3D%22%2394a3b8%22%20font-family%3D%22system-ui%2Csans-serif%22%20font-size%3D%2236%22%20x%3D%22300%22%20y%3D%22182%22%20text-anchor%3D%22middle%22%3E%F0%9F%93%B7%3C%2Ftext%3E%3Ctext%20fill%3D%22%23f8fafc%22%20font-family%3D%22system-ui%2Csans-serif%22%20font-size%3D%2220%22%20font-weight%3D%22600%22%20x%3D%22300%22%20y%3D%22250%22%20text-anchor%3D%22middle%22%3EPhoto%20Unavailable%20%2F%20Syncing%3C%2Ftext%3E%3Ctext%20fill%3D%22%2394a3b8%22%20font-family%3D%22system-ui%2Csans-serif%22%20font-size%3D%2214%22%20x%3D%22300%22%20y%3D%22280%22%20text-anchor%3D%22middle%22%3EClick%20to%20inspect%20details%3C%2Ftext%3E%3C%2Fsvg%3E';" />
                        <span class="photo-overlay-badge"><i class="bi bi-arrows-fullscreen me-1"></i>View Photo</span>
                    </div>
                }
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h2 class="h5 mb-1 fw-bold">@stageName</h2>
                        <span class="badge bg-secondary">@report.Status</span>
                    </div>
                    <p class="text-muted small mb-2 d-flex flex-wrap align-items-center gap-2">
                        <span>@loggedTimeStr · @report.ReportedBy</span>
                        @if (report.IsOffSite)
                        {
                            <span class="badge bg-danger text-white"><i class="bi bi-geo-alt-fill me-1"></i>Off-Site (@(report.DistanceFromSiteMeters ?? 0)m away)</span>
                        }
                        else if (report.Latitude != null)
                        {
                            <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>Verified On-Site</span>
                        }
                    </p>
                    <p class="mb-3 text-secondary">@report.Description</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small fw-semibold text-muted">Progress Recorded</span>
                        <span class="badge bg-primary">@report.ProgressPercent%</span>
                    </div>
                </div>
            </article>
        }
    </div>
}

<!-- Lightbox Modal -->
<div class="modal fade" id="photoLightboxModal" tabindex="-1" aria-labelledby="photoLightboxTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:var(--card-bg, #ffffff); border-radius:14px; overflow:hidden;">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold" id="photoLightboxTitle">Site Inspection Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center bg-dark d-flex align-items-center justify-content-center" style="min-height:360px; max-height:70vh; overflow:hidden;">
                <img id="lightboxImage" src="" alt="Full site photo" style="max-width:100%; max-height:70vh; object-fit:contain;" />
            </div>
            <div class="modal-footer d-flex justify-content-between border-top py-2 px-3">
                <div class="text-muted small text-start">
                    <span id="lightboxReporter" class="fw-semibold text-dark"></span> &bull; 
                    <span id="lightboxTimestamp"></span> &bull; 
                    <span id="lightboxProgress" class="badge bg-primary ms-1"></span>
                </div>
                <div>
                    <a id="lightboxNewTabBtn" href="#" target="_blank" class="btn btn-sm btn-outline-secondary me-2">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Open Direct Image
                    </a>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function openPhotoLightbox(photoUrl, stageName, reporter, timestamp, progress) {
    document.getElementById('photoLightboxTitle').textContent = stageName + ' - Site Inspection Photo';
    document.getElementById('lightboxImage').src = photoUrl;
    document.getElementById('lightboxReporter').textContent = 'Captured by: ' + reporter;
    document.getElementById('lightboxTimestamp').textContent = timestamp;
    document.getElementById('lightboxProgress').textContent = progress;
    document.getElementById('lightboxNewTabBtn').href = photoUrl;
    
    var modalEl = document.getElementById('photoLightboxModal');
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
}
</script>

<style>
.site-report-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:20px; }
.site-report-card { overflow:hidden; border-radius:10px; transition:transform 0.15s ease-in-out; }
.site-report-card:hover { transform:translateY(-2px); }
.site-report-photo { width:100%; height:220px; object-fit:cover; background:#1e293b; display:block; }
.photo-container { position:relative; overflow:hidden; }
.photo-overlay-badge {
    position:absolute; bottom:10px; right:10px;
    background:rgba(15, 23, 42, 0.75); color:#ffffff;
    font-size:0.75rem; font-weight:600; padding:4px 8px; border-radius:6px;
    pointer-events:none; transition:opacity 0.2s ease;
    backdrop-filter:blur(4px);
}
.photo-container:hover .photo-overlay-badge { background:rgba(37, 99, 235, 0.9); }
</style>
