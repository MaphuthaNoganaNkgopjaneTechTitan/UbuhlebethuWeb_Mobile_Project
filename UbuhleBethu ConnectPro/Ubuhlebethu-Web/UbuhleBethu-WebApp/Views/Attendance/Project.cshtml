@model IReadOnlyList<UbuhlebethuConnectPro.WebApp.ApiClient.AttendanceDto>
@{
    ViewData["Title"] = "Site Attendance";
    var projectId = ViewBag.ProjectId != null ? ViewBag.ProjectId.ToString() : "";
    var filterDate = ViewBag.FilterDate as string;
}

<div class="mb-3">
    @if (!string.IsNullOrEmpty(projectId))
    {
        <a href="@Url.Action("Details", "Dashboard", new { id = projectId })" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Project Details
        </a>
    }
    else
    {
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    }
</div>

<div class="page-header d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title h3 mb-1">Site Attendance</h1>
        <p class="page-subtitle text-muted mb-0">Worker shift check-ins, check-outs, GPS geofencing, and daily wage records</p>
    </div>
    <form method="get" asp-action="Project" class="d-flex gap-2 align-items-center">
        <input type="hidden" name="id" value="@projectId" />
        <input type="date" name="date" value="@filterDate" class="form-control form-control-sm" style="width:160px;" />
        <button class="btn btn-primary btn-sm" type="submit">Filter Date</button>
        @if (!string.IsNullOrEmpty(filterDate))
        {
            <a href="@Url.Action("Project", "Attendance", new { id = projectId })" class="btn btn-outline-secondary btn-sm">View All Dates</a>
        }
    </form>
</div>

<div class="card shadow-sm border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Worker</th>
                    <th>Date</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Geofence Status</th>
                    <th>Daily Rate</th>
                </tr>
            </thead>
            <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <div style="font-size:1.8rem;" class="mb-2">🕒</div>
                        <h6 class="fw-bold mb-1">No Attendance Records Found</h6>
                        <p class="small text-muted mb-0">No workers have clocked in for this project on @(string.IsNullOrEmpty(filterDate) ? "any recorded date" : filterDate).</p>
                    </td>
                </tr>
            }
            else
            {
                foreach (var record in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <i class="bi bi-person-circle me-1 text-primary"></i>
                            @record.WorkerName
                        </td>
                        <td>@record.Date</td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                <i class="bi bi-box-arrow-in-right me-1"></i>@record.CheckInTime
                            </span>
                        </td>
                        <td>
                            @if (record.CheckOutTime == "Not Finished" || record.CheckOutTime.Contains("On Shift"))
                            {
                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning">
                                    <i class="bi bi-clock-history me-1"></i>Active (On Shift)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-dark border">
                                    <i class="bi bi-box-arrow-right me-1"></i>@record.CheckOutTime
                                </span>
                            }
                        </td>
                        <td>
                            @if (record.IsOffSite)
                            {
                                <span class="badge bg-danger text-white">
                                    <i class="bi bi-geo-alt-fill me-1"></i>Off-Site (@(record.DistanceFromSiteMeters ?? 0)m away)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success text-white">
                                    <i class="bi bi-check-circle me-1"></i>Verified On-Site
                                </span>
                            }
                        </td>
                        <td class="fw-bold">ZAR @record.DailyRate.ToString("N2")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
